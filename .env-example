# --- Database Configuration ---
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=mydatabase

# --- Security & Tokens ---
JWT_SECRET=your_super_secret_jwt_key_that_is_long_enough_here
FRONTEND_URL=https://localhost

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Mailtrap ---
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password

# --- SSL Configuration ---
SSL_PORT=8443
SSL_KEYSTORE_PASSWORD=your_keystore_password

# --- Nginx Certificate Paths (Relative to docker-compose.yml) ---
SSL_KEY_PATH=./backend/cert/server.key
SSL_CERT_PATH=./backend/cert/server.crt